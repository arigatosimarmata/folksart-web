{
  "openapi": "3.0.3",
  "info": {
    "title": "Folksart IAM Central API Gateway",
    "description": "Comprehensive RESTful Swagger / OpenAPI Specification mapping all frontend components including Gateway SSO authentication, Administrator Console Identity Lifecycles, KYC Document Upload with Verification status automation, and Developer compliance telemetry audit tracking.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Production Sandbox Environment"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate user identity",
        "description": "Verifies password credentials against phone, email, or username identifier. Supports direct MFA requirement flow redirection.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "identifier",
                  "password"
                ],
                "properties": {
                  "identifier": {
                    "type": "string",
                    "example": "security.admin"
                  },
                  "password": {
                    "type": "string",
                    "example": "SuperSecretP@ssword123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication validated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "example": "fol_at_8k92P0mN7x2v1qZ"
                    },
                    "mfaRequired": {
                      "type": "boolean",
                      "example": false
                    },
                    "user": {
                      "$ref": "#/components/schemas/IAMUser"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials provided."
          }
        }
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "summary": "Verify 2FA TOTP code",
        "description": "Validates single-use MFA code if MFA flow state is requested.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tempToken",
                  "code"
                ],
                "properties": {
                  "tempToken": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "example": "482015"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MFA code is correct. Returns active session token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/IAMUser"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/sso/callback": {
      "post": {
        "summary": "SSO Providers callback integration",
        "description": "Authenticates identities using secure SSO claims directly from verified Google or Apple secure payloads.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "provider",
                  "credential"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "Google",
                      "Apple"
                    ]
                  },
                  "credential": {
                    "type": "string",
                    "description": "OAuth token string issued by provider JWT verification handshake"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSO Handshake Resolved Successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/IAMUser"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/identities": {
      "get": {
        "summary": "List IAM identities",
        "description": "Retrieves collection of subjects enrolled with search and tabular filters.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kycStatus",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Identities lists retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/IAMUser"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "example": 45
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Provision new IAM user identity",
        "description": "Registers a new subject and triggers internal password setup email workflows.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "role",
                  "department"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Carol Danvers"
                  },
                  "email": {
                    "type": "string",
                    "example": "carol.danvers@folksart.corp"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "Administrator",
                      "Operator",
                      "Security Officer",
                      "End User"
                    ]
                  },
                  "department": {
                    "type": "string",
                    "example": "Aviation Command"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Identity provisioned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IAMUser"
                }
              }
            }
          }
        }
      }
    },
    "/identities/{id}": {
      "put": {
        "summary": "Update IAM identity",
        "description": "Modifies user roles, contact particulars, metadata attributes, or department groupings.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IAMUserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User profile successfully modified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IAMUser"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "De-provision IAM user",
        "description": "Permanently deletes or soft-deletes a user profile record and invalidates credentials.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile de-provisioned successfully."
          }
        }
      }
    },
    "/identities/me": {
      "get": {
        "summary": "Fetch logged-in profile",
        "description": "Gets full context details of the currently authorized subkey subject.",
        "responses": {
          "200": {
            "description": "Logged-in record details profile loaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IAMUser"
                }
              }
            }
          }
        }
      }
    },
    "/kyc/upload": {
      "post": {
        "summary": "Process KYC document file upload",
        "description": "Upload physical scanned photo credentials to cloud workspace directory systems and schedules secure automatic OCR verification checks.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "file"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "The category of the verification document being transmitted",
                    "enum": [
                      "Passport",
                      "Driver License",
                      "National ID"
                    ],
                    "example": "Passport"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Scanned document file resource. Supported MIME types: image/jpeg, image/png, application/pdf. Maximum file size allowed: 10MB (10,485,760 bytes)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "KYC document registered and scheduling status verification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KYCDocument"
                }
              }
            }
          }
        }
      }
    },
    "/kyc/documents": {
      "get": {
        "summary": "Retrieve all pending and processed KYC documents",
        "description": "Lists all user verification files for auditing by compliance administrators.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Idle",
                "Processing",
                "Approved",
                "Rejected"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "KYC list fetch resolved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KYCDocument"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/kyc/documents/{id}/review": {
      "post": {
        "summary": "Perform manual KYC validation review",
        "description": "Fulfills manual governance checks, updating the target subject's credential status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "Approved",
                      "Rejected"
                    ]
                  },
                  "validationMessage": {
                    "type": "string",
                    "example": "Slight reflection covering ID number lines"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review status accepted and audit trails written."
          }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "summary": "Query event streams audit logs",
        "description": "Returns security and compliance metrics history index records logs.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logs tracking metrics array returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditLog"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/developer/keys": {
      "get": {
        "summary": "List active service client API Keys",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/APIKey"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Generate a new service API Key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "expiresInDays"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Production Webhook Service"
                  },
                  "expiresInDays": {
                    "type": "integer",
                    "example": 90
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Provides the raw newly-minted credential. Visually accessible only once.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rawKey": {
                      "type": "string",
                      "example": "fol_sk_prod_99f2aK8s10z9..."
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/APIKey"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/developer/keys/{id}": {
      "delete": {
        "summary": "Revoke Client API Key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Credential target token has been successfully blacklisted."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque/JWT"
      }
    },
    "schemas": {
      "IAMUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "usr_9J2fK8xP"
          },
          "name": {
            "type": "string",
            "example": "Tony Stark"
          },
          "username": {
            "type": "string",
            "example": "tony.stark"
          },
          "email": {
            "type": "string",
            "example": "tony@stark.corp"
          },
          "phone": {
            "type": "string",
            "example": "+1-202-555-0143"
          },
          "avatar": {
            "type": "string",
            "example": "https://img.avatar"
          },
          "role": {
            "type": "string",
            "enum": [
              "Administrator",
              "Operator",
              "Security Officer",
              "End User"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Deactivated",
              "Banned"
            ]
          },
          "kycStatus": {
            "type": "string",
            "enum": [
              "Verified",
              "Pending Review",
              "Not Started",
              "Action Required"
            ]
          },
          "mfaEnabled": {
            "type": "boolean"
          },
          "mfaMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ssoProvider": {
            "type": "string",
            "nullable": true
          },
          "department": {
            "type": "string",
            "example": "Quantum Engineering"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActive": {
            "type": "string",
            "format": "date-time"
          },
          "riskScore": {
            "type": "integer"
          },
          "opaqueToken": {
            "type": "string"
          }
        }
      },
      "IAMUserUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "mfaEnabled": {
            "type": "boolean"
          }
        }
      },
      "KYCDocument": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Passport",
              "Driver License",
              "National ID"
            ]
          },
          "fileName": {
            "type": "string"
          },
          "fileSize": {
            "type": "string"
          },
          "uploadDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "Idle",
              "Processing",
              "Approved",
              "Rejected"
            ]
          },
          "validationMessage": {
            "type": "string"
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "ipAddress": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          }
        }
      },
      "APIKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "maskedKey": {
            "type": "string",
            "example": "fol_sk_prod_••••••••••••3z21"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
